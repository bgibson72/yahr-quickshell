# Mako Notification Daemon Configuration
# Theme: Everforest

# General settings
font=Maple Mono NF 13
max-visible=5
sort=-time
layer=overlay
anchor=top-right
margin=8
padding=12
border-size=3
border-radius=12
background-color=#2b3339
text-color=#d3c6aa
border-color=#7fbbb3
progress-color=over #7fbbb3

# Default timeout
default-timeout=10000

# Dimensions
width=400
height=150
max-icon-size=48

# Grouping
group-by=app-name

# Urgency levels
[urgency=low]
border-color=#a7c080
default-timeout=5000

[urgency=normal]
border-color=#7fbbb3
default-timeout=10000

[urgency=critical]
border-color=#e67e80
default-timeout=0

# Icons
icons=1
icon-path=/usr/share/icons/Papirus-Dark

# Format
format=<b>%s</b>\n%b
