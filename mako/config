# Mako Notification Daemon Configuration
# Theme: Gruvbox

# General settings
font=JetBrainsMono Nerd Font 13
max-visible=5
sort=-time
layer=overlay
anchor=top-right
margin=8
padding=12
border-size=2
border-radius=12
background-color=#282828
text-color=#ebdbb2
border-color=#83a598
progress-color=over #83a598

# Default timeout
default-timeout=10000

# Dimensions
width=400
height=150
max-icon-size=48

# Grouping
group-by=app-name

# Urgency levels
[urgency=low]
border-color=#b8bb26
default-timeout=5000

[urgency=normal]
border-color=#83a598
default-timeout=10000

[urgency=critical]
border-color=#fb4934
default-timeout=0

# Icons
icons=1
icon-path=/usr/share/icons/Papirus-Dark

# Format
format=<b>%s</b>\n%b
