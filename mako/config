# Mako Notification Daemon Configuration
# Theme: Eldritch

# General settings
font=JetBrainsMono 13
markup=1
max-visible=5
sort=-time
layer=overlay
anchor=top-right
margin=8
padding=14
border-size=1
border-radius=16
background-color=#212337E8
text-color=#ebfafa
border-color=#a48cf259
progress-color=over #a48cf259

# Default timeout
default-timeout=10000

# Dimensions
width=400
height=150
max-icon-size=48

# Grouping
group-by=app-name

# Urgency levels
[urgency=low]
border-color=#37f49959
default-timeout=5000

[urgency=normal]
border-color=#a48cf259
default-timeout=10000

[urgency=critical]
border-color=#f16c7599
default-timeout=0

# Icons
icons=1
icon-path=/usr/share/icons/Papirus-Dark

# Format
format=<b>%s</b>\n%b
