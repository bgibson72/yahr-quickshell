# Mako Notification Daemon Configuration
# Theme: Kanagawa

# General settings
font=JetBrainsMono 13
markup=1
max-visible=5
sort=-time
layer=overlay
anchor=top-right
margin=8
padding=12
border-size=2
border-radius=12
background-color=#1f1f28
text-color=#dcd7ba
border-color=#7e9cd8
progress-color=over #7e9cd8

# Default timeout
default-timeout=10000

# Dimensions
width=400
height=150
max-icon-size=48

# Grouping
group-by=app-name

# Urgency levels
[urgency=low]
border-color=#98bb6c
default-timeout=5000

[urgency=normal]
border-color=#7e9cd8
default-timeout=10000

[urgency=critical]
border-color=#e46876
default-timeout=0

# Icons
icons=1
icon-path=/usr/share/icons/Papirus-Dark

# Format
format=<b>%s</b>\n%b
